<Project Sdk="Microsoft.NET.Sdk">

  <!-- Machine-specific paths belong in Storybrew.props, which is gitignored. See README.md. -->
  <Import Project="Storybrew.props" Condition="Exists('Storybrew.props')" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <StorybrewPath Condition="'$(StorybrewPath)' == ''">$(STORYBREW_PATH)</StorybrewPath>
    <StorybrewPath Condition="'$(StorybrewPath)' == ''">..\storybrew</StorybrewPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="StorybrewCommon">
      <HintPath>$(StorybrewPath)\StorybrewCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenTK">
      <HintPath>$(StorybrewPath)\OpenTK.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="VerifyStorybrewPath" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(StorybrewPath)\StorybrewCommon.dll')"
           Text="StorybrewCommon.dll was not found in '$(StorybrewPath)'. Point StorybrewPath at the folder holding StorybrewEditor.exe: set a STORYBREW_PATH environment variable, pass -p:StorybrewPath=&quot;C:\path\to\storybrew&quot;, or create Storybrew.props. See README.md." />
  </Target>

</Project>
